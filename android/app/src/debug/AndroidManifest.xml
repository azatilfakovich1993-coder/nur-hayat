<?xml version="1.0" encoding="utf-8" ?>
<!--
  Разрешение на незашифрованный HTTP — ТОЛЬКО для отладочной сборки.

  Оно нужно, чтобы проверять видео с http-сервера на компьютере разработчика.
  Раньше строка стояла в общем манифесте и уезжала в релиз: у всех
  пользователей приложение принимало незашифрованный трафик, а значит в чужой
  Wi-Fi сети содержимое можно было подменить по дороге. В релизе приложение
  ходит только по https, поэтому там это разрешение не нужно вовсе.

  Отладочная сборка ставится отдельным приложением (applicationIdSuffix
  ".debug"), так что на релизную версию это никак не влияет.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:usesCleartextTraffic="true" />
</manifest>
