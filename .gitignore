# Capacitor Android — закоммичен намеренно: содержит ручные правки
# (POST_NOTIFICATIONS/SCHEDULE_EXACT_ALARM в манифесте, иконки приложения),
# которые иначе придётся каждый раз восстанавливать после `cap add android`
ios/

# Локальные состояния CLI — не для git
.netlify/
cloudflare-worker/.wrangler/

# Содержит service_role ключи в открытом виде
migration/migrate.mjs

# Собранные пакеты приложения — гигабайты бинарников, которым не место в git.
# (Несколько старых APK попали в историю раньше — вычищать отдельно.)
*.apk
*.aab

# Веб-сборка, которую `cap sync` копирует в Android-проект. Генерируется из
# dist/ при каждой сборке, хранить её в git незачем.
android/app/src/main/assets/

# Временные файлы отладки
test-out.txt
